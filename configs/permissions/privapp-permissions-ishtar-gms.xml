<permissions>
    <!-- The current GMS DeskClock APK uses com.android.deskclock while the
         bundled Google allowlist still targets com.google.android.deskclock. -->
    <privapp-permissions package="com.android.deskclock">
        <permission name="android.permission.START_FOREGROUND_SERVICES_FROM_BACKGROUND"/>
        <permission name="android.permission.CONTROL_DISPLAY_COLOR_TRANSFORMS"/>
    </privapp-permissions>
</permissions>
